# @file CancelStationOrderBatch.srv
# @brief 按批次号批量取消该批次尚未完成的订单任务。
# @details 所属包：robot_interfaces_mission
#
string batch_id  # 批次标识（与提交时一致）
bool cancel_active  # true 表示连正在执行的任务一并中断
---
bool success  # 是否成功；false 时原因见 message
string message  # 结果说明；失败时为失败原因
string[] canceled_mission_ids  # 实际被取消的任务 ID 列表
bool active_cancel_requested  # 是否已请求中断当前执行中的任务
int32 queue_size  # 本次操作后，任务队列中的任务总数
