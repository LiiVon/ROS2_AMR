# @file GetDockState.srv
# @brief 查询单个停靠点的详细状态与占用情况。
# @details 所属包：robot_interfaces_mission
#
string dock_id  # 停靠点 ID
---
bool success  # 是否成功；false 时原因见 message
string message  # 结果说明；失败时为失败原因
string dock_id  # 停靠点 ID（回显）
string station_id  # 停靠点所在站点 ID
string approach_station_id  # 接近站点 ID（停靠前的准备点）
string charger_resource_id  # 关联的充电资源 ID（非充电码头为空）
bool enabled  # 停靠点是否启用
bool available  # 当前是否可被占用
string state  # 停靠状态：APPROACHING / CHARGING / FAILED / REJECTED 等
string mission_id  # 当前占用该停靠点的任务 ID；空闲时为空
