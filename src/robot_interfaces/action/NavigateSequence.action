# NavigateSequence.action
# 按顺序执行一组导航目标点，并可以选择循环执行

# 请求：
# 导航目标点列表
# geometry_msgs/PoseStamped 是 ROS 2 中表示带时间戳和坐标系的位姿的消息。
# header.frame_id：目标点所属的坐标系，例如 map。
# pose.position：位置坐标 (x,y,z)。
# pose.orientation：姿态，通常使用四元数表示旋转。
geometry_msgs/PoseStamped[] goals 
bool loop # 是否循环执行目标点
---

# 响应
bool success # 是否成功执行完所有目标点
string message # 执行结果的描述信息
int32 succeeded_goals # 成功执行的目标点数量
int32 failed_goals # 执行失败的目标点数量
---

# 反馈
int32 current_goal_index # 当前正在执行的目标点索引
int32 total_goals # 总的目标点数量
string state # 当前导航状态，例如 "navigating", "succeeded", "failed"   
string message # 当前导航状态的描述信息