# @file CancelWorkflow.srv
# @brief 取消某个订单的工作流：清除其排队任务，可选中断正在执行的任务。
# @details 所属包：robot_interfaces_business
#
string order_id  # 订单号
bool cancel_active  # true 表示连正在执行的任务一并取消
---
bool success  # 是否成功；false 时原因见 message
string message  # 结果说明；失败时为失败原因
string[] canceled_mission_ids  # 被取消的任务 ID 列表
bool active_cancel_requested  # 是否已请求中断当前执行中的任务
int32 queue_size  # 本次操作后，任务队列中的任务总数
