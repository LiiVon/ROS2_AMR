# @file ResumeWorkflow.srv
# @brief 恢复某个订单的工作流：继续排队步骤，可选同时恢复被暂停的任务。
# @details 所属包：robot_interfaces_business
#
string order_id  # 订单号
bool resume_active  # true 表示同时恢复被暂停的执行中任务
---
bool success  # 是否成功；false 时原因见 message
string message  # 结果说明；失败时为失败原因
string[] affected_mission_ids  # 受影响的（已恢复的）任务 ID 列表
bool active_resume_requested  # 是否已请求恢复执行中的任务
int32 queue_size  # 本次操作后，任务队列中的任务总数
