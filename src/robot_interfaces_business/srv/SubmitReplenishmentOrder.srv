# SubmitReplenishmentOrder.srv
# 提交仓库补货订单，并返回履约记录和机器人任务信息

# 补货订单 ID
string order_id

# 需要补充的商品 SKU ID
string sku_id

# 用于承载商品的周转箱 ID
string tote_id

# 补货商品的来源站点 ID
string source_station

# 补货目标产线或工位的站点 ID
string line_station

# 本次需要补充的商品数量
int32 quantity

# 订单优先级，数值含义以系统约定为准
int32 priority

# 系统空闲时，是否尝试立即启动订单
bool start_if_idle
---
# 提交结果
bool success
string message

# 创建或关联的订单履约记录 ID
string fulfillment_id

# 当前履约任务的状态
string state

# 本次订单关联或创建的机器人任务 ID 列表
string[] mission_ids

# 操作处理后的任务队列总数量
int32 queue_size