# SubmitTransportOrder.srv
# 提交运输订单，指定取货点和卸货点的位姿

# 运输订单 ID
string order_id

# 位姿所使用的参考坐标系 ID，例如 map
string frame_id

# 取货点的 X 坐标
float64 pickup_x

# 取货点的 Y 坐标
float64 pickup_y

# 取货点的偏航角（绕 Z 轴旋转的角度，单位通常为 rad）
float64 pickup_yaw

# 卸货点的 X 坐标
float64 dropoff_x

# 卸货点的 Y 坐标
float64 dropoff_y

# 卸货点的偏航角（绕 Z 轴旋转的角度，单位通常为 rad）
float64 dropoff_yaw

# 运输任务优先级，数值含义以系统约定为准
int32 priority

# 系统空闲时，是否尝试立即启动任务
bool start_if_idle
---
# 提交结果
bool success
string message

# 创建或关联的机器人任务 ID
string mission_id

# 操作处理后的任务队列总数量
int32 queue_size