# @file ListMapZones.srv
# @brief 列出指定地图的区域定义（多边形、类型、限速）。
# @details 所属包：robot_interfaces_navigation
#
string map_name  # 地图名称；为空时使用当前激活地图
bool include_disabled  # true 表示连 enabled=false 的区域一并返回
---
bool success  # 是否成功；false 时原因见 message
string message  # 结果说明；失败时为失败原因
robot_interfaces_navigation/MapZone[] zones  # 区域列表（见 MapZone.msg）
